---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetailIsland from '../../components/islands/ProjectDetailPage';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map(p => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;

const shortDesc = project.detailedDescription?.context?.content?.slice(0, 160) ??
  `Projet ${project.title} par Maxime Mandin.`;

const ogImageSrc = (project.image as any)?.src ?? '';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  "name": project.title,
  "description": shortDesc,
  "image": ogImageSrc ? `https://mandinmaxime.fr${ogImageSrc}` : undefined,
  "artMedium": project.categories?.[0] ?? "Digital Design",
  "artform": "Digital Design",
  "creator": {
    "@type": "Person",
    "name": "Maxime Mandin",
    "url": "https://mandinmaxime.fr"
  }
};
---

<BaseLayout
  title={`${project.title} — Maxime Mandin`}
  description={shortDesc}
  ogImage={ogImageSrc}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="py-8 px-4 md:px-8">
    <div class="mx-auto max-w-7xl">

      <!-- Breadcrumb -->
      <nav aria-label="Fil d'Ariane" class="mb-4 flex items-center gap-1 text-xs px-2 py-1 shadow-[inset_1px_1px_0_0_#808080,inset_-1px_-1px_0_0_#fff] bg-gray-300 animate-fade-in">
        <a href="/" class="hover:underline transition-colors">Accueil</a>
        <span aria-hidden="true" class="text-gray-500 px-1">›</span>
        <a href="/catalogue" class="hover:underline transition-colors">Projets</a>
        <span aria-hidden="true" class="text-gray-500 px-1">›</span>
        <span class="font-semibold text-gray-900 truncate">{project.title}</span>
      </nav>

      <!-- Détail du projet : layout agence (fenêtre infos sticky + galerie) -->
      <ProjectDetailIsland project={project} client:load />

    </div>
  </div>
</BaseLayout>
